page {
  background: #090806;
  color: #f4ead6;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  min-height: 100%;
}

.page {
  padding: 28rpx 24rpx 48rpx;
}

.card {
  background: linear-gradient(180deg, rgba(32, 26, 18, 0.94), rgba(18, 15, 11, 0.88));
  border: 1rpx solid rgba(212, 175, 55, 0.16);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #d4af37;
  font-size: 22rpx;
  letter-spacing: 0.16em;
}

.price {
  font-size: 88rpx;
  line-height: 1;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.muted {
  color: #8c8170;
  font-size: 24rpx;
}

.up {
  color: #d24b3a;
}

.down {
  color: #2f9b6a;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.stat {
  width: 50%;
  padding: 16rpx 8rpx 8rpx 0;
  box-sizing: border-box;
}

.stat-label {
  color: #8c8170;
  font-size: 22rpx;
}

.stat-value {
  font-size: 34rpx;
  margin-top: 6rpx;
}

.btn {
  background: linear-gradient(180deg, #f3d789, #c9a227);
  color: #1a1408;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #f4ead6;
  border: 1rpx solid rgba(212, 175, 55, 0.28);
  border-radius: 999rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.08);
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.12);
  color: #d4af37;
}
