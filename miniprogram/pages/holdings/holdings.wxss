.nav, .nav-on { display: inline; }
.nav {
  display: flex;
  gap: 28rpx;
  margin-bottom: 24rpx;
  color: #8c8170;
  font-size: 28rpx;
}
.nav-on { color: #d4af37; font-weight: 600; }
.field { color: #8c8170; font-size: 24rpx; margin: 18rpx 0 8rpx; }
.input {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(212,175,55,0.12);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  color: #f4ead6;
}
.btn { margin-top: 28rpx; }
.del { color: #8c8170; font-size: 24rpx; }
