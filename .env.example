# 对外端口由 Caddy 占用 80/443，一般不用改。
# 填了域名后，部署脚本会自动申请 https 证书。
MYGOLD_DOMAIN=ohmygold.icu
# 申请证书用的邮箱，可空
ACME_EMAIL=

# 初始账号。只在数据库里一个账号都没有时用来建号，之后改了密码不会被覆盖回去。
# 仓库是公开的，config.py 里的默认密码等于公开值，首次部署前请在这里填一个真密码。
MYGOLD_BOOTSTRAP_USERNAME=hemeng
MYGOLD_BOOTSTRAP_PASSWORD=
# 已经建过号之后想改密码，走脚本，不要改上面这行：
#   docker compose exec mygold python backend/scripts/set_password.py hemeng

# 令牌签名密钥。留空则每次启动随机生成，后端重启后需要重新登录。
# 想让登录状态跨重启保留，填一个长随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYGOLD_AUTH_SECRET=

# OpenClaw 通用推送配置（保留备用，当前没有自动推送内容或任务）。
MYGOLD_OPENCLAW_WEBHOOK_URL=
# webhook Bearer Token。
MYGOLD_OPENCLAW_WEBHOOK_TOKEN=
# /hooks/agent 显式投递到的飞书 open_id。
MYGOLD_OPENCLAW_TARGET=
# 旧播报账号参数兼容保留，当前不生效。
MYGOLD_OPENCLAW_REPORT_USERNAME=hemeng
# 旧推送时间参数兼容保留，当前不注册任何推送任务。
MYGOLD_PORTFOLIO_REPORT_HOUR=16
MYGOLD_PORTFOLIO_REPORT_MINUTE=10
# /hooks/agent 要跑一次模型，超时不能按普通 HTTP 请求设得太短。
MYGOLD_OPENCLAW_TIMEOUT_SECONDS=15

# 全 A 股 DeepSeek 分析。仅在服务器 .env 填写密钥，不要提交到 Git。
# 留空时仍可使用规则扫描；填写后仅点击AI分析按钮才提交最多20只候选，不自动调用模型。
MYGOLD_DEEPSEEK_API_KEY=
MYGOLD_DEEPSEEK_MODEL=deepseek-flash
MYGOLD_DEEPSEEK_TIMEOUT_SECONDS=45

# 分板块、分成交额档位的日线研究样本数（12～120）。
MYGOLD_STOCK_RESEARCH_SAMPLE_SIZE=90
