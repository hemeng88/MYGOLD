# 对外端口由 Caddy 占用 80/443，一般不用改。
# 填了域名后，部署脚本会自动申请 https 证书。
MYGOLD_DOMAIN=ohmygold.icu
# 申请证书用的邮箱，可空
ACME_EMAIL=

# 初始账号。只在数据库里一个账号都没有时用来建号，之后改了密码不会被覆盖回去。
# 仓库是公开的，config.py 里的默认密码等于公开值，首次部署前请在这里填一个真密码。
MYGOLD_BOOTSTRAP_USERNAME=hemeng
MYGOLD_BOOTSTRAP_PASSWORD=
# 已经建过号之后想改密码，走脚本，不要改上面这行：
#   docker compose exec mygold python backend/scripts/set_password.py hemeng

# 令牌签名密钥。留空则每次启动随机生成，后端重启后需要重新登录。
# 想让登录状态跨重启保留，填一个长随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYGOLD_AUTH_SECRET=

# OpenClaw 基金阈值提醒（留空则关闭）。OpenClaw webhook 收到 JSON 后负责发飞书。
MYGOLD_OPENCLAW_WEBHOOK_URL=
# 如果 webhook 要求 Bearer Token，填这里。
MYGOLD_OPENCLAW_WEBHOOK_TOKEN=
# 估算涨跌达到这个绝对百分比时提醒，例如 1.0 表示 ±1%。每个方向每天最多一条。
MYGOLD_FUND_ALERT_THRESHOLD_PCT=1.0
MYGOLD_FUND_ALERT_TIMEOUT_SECONDS=8
